# AI_PROVIDER: anthropic (default) or groq. Change it in Netlify to switch, then redeploy.
AI_PROVIDER=anthropic
# Groq free tier (https://console.groq.com): used when AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Set these in Netlify: Site configuration -> Environment variables. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional. Comma-separated extra origins allowed to call /api/ask (your Netlify URL is allowed automatically).
ALLOWED_ORIGIN=https://your-domain.com
